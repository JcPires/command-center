# Command Centre — environment
# Copy to .env and edit. Loaded by start.sh / `cc start`.

# Server
CC_PORT=8765
CC_HOST=127.0.0.1

# Data
CC_DB_PATH=./data/command-centre.db
CC_PROJECTS_DIR=$HOME/.claude/projects

# Mission Control
MISSION_CONTROL_DEFAULT_MODEL=claude-sonnet-4-6
MAX_CONCURRENT_TASKS=3
TASK_TIMEOUT_SECONDS=900

# OTEL — set these in ~/.claude/settings.json so Claude Code POSTs to us.
# (See `cc setup otel` for the wizard that updates that file.)
# CLAUDE_CODE_ENABLE_TELEMETRY=1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:8765
# OTEL_EXPORTER_OTLP_PROTOCOL=http/json
# OTEL_METRICS_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=otlp
# OTEL_LOG_TOOL_DETAILS=1

# Anthropic (optional, for skill_router + NL→cron)
# ANTHROPIC_API_KEY=
