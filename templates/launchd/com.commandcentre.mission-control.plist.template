<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.commandcentre.mission-control</string>

    <key>ProgramArguments</key>
    <array>
      <string>{{PYTHON}}</string>
      <string>{{INSTALL_DIR}}/.claude/skills/mission-control/scripts/heartbeat.py</string>
      <string>--once</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{INSTALL_DIR}}</string>

    <key>EnvironmentVariables</key>
    <dict>
      <key>CC_PROJECT_ROOT</key>
      <string>{{PROJECT_ROOT}}</string>
      <key>CC_PORT</key>
      <string>{{PORT}}</string>
      <key>MISSION_CONTROL_DEFAULT_MODEL</key>
      <string>{{DEFAULT_MODEL}}</string>
      <key>PATH</key>
      <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>StartInterval</key>
    <integer>120</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>{{INSTALL_DIR}}/logs/mission-control.out.log</string>
    <key>StandardErrorPath</key>
    <string>{{INSTALL_DIR}}/logs/mission-control.err.log</string>
  </dict>
</plist>
